# ==========================================
# INFRASTRUCTURE ENVIRONMENT VARIABLES
# ==========================================
# Cấu trúc: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:your_db_password_here@your-db-host.com:6543/postgres?pgbouncer=true


# ==========================================
# BACKEND ENVIRONMENT VARIABLES
# ==========================================
PORT=3000
NODE_ENV=development

# Database (Kết nối trực tiếp không qua pooler)
DB_HOST=your-db-host.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASS=your_db_password_here
DB_NAME=postgres

# Redis Cache (Dùng 127.0.0.1 nếu chạy API local, dùng 'redis' nếu chạy trong Docker)
REDIS_URL=redis://127.0.0.1:6379

# RabbitMQ (Dùng 127.0.0.1 nếu chạy API local, dùng 'rabbitmq' nếu chạy trong Docker)
RABBITMQ_URL=amqp://127.0.0.1:5672

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d

# Cache Configuration (Thời gian tính bằng giây)
CACHE_WORKSHOP_NEW_DURATION=3600
CACHE_WORKSHOP_EVENT_WINDOW=1800

# AWS S3 (Upload File)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=unihub-workshop-uploads
CDN_BASE_URL=https://cdn.unihub.example

# ==========================================
# AI (DeepSeek) - Workshop Generation
# ==========================================
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ==========================================
# FRONTEND ENVIRONMENT VARIABLES
# ==========================================
VITE_API_BASE_URL=/api
